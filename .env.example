# Copy this file to .env and adjust. Never commit .env to version control.

# --- Core ---------------------------------------------------------------
# 1 = development (detailed errors, demo data allowed). Use 0 in production.
DJANGO_DEBUG=0
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Host names / IP addresses users type in their browser, comma-separated.
# Example for the hotel LAN: localhost,127.0.0.1,192.168.1.20,it-server
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed when using a non-default port or HTTPS, e.g. http://192.168.1.20:8000
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set to 1 only when served over HTTPS (secure cookies, redirect to HTTPS). See docs/DEPLOYMENT.md section 8.
DJANGO_USE_HTTPS=0
# After HTTPS has worked for a week: 31536000 (browsers then refuse plain HTTP for a year).
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_ADMIN_URL=django-admin/

# --- Hotel defaults (can be changed later in System Configuration) -------
HOTEL_NAME=Hotel
HOTEL_TIMEZONE=Africa/Nairobi

# --- Database -------------------------------------------------------------
# sqlite for local development, postgres for production.
DB_ENGINE=sqlite
DB_NAME=hotel_it
DB_USER=hotel_it
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Storage --------------------------------------------------------------
# Private folder for uploaded evidence (NOT inside the web root).
# PRIVATE_MEDIA_ROOT=D:\HotelIT\media_private

# --- Backups (docs/BACKUP_AND_RESTORE.md) ------------------------------------
# BACKUP_ROOT=D:\HotelIT\backups
# Second copy on another disk or a NAS share (UNC path, not a mapped drive letter).
# BACKUP_COPY_TO=\\nas\backups\hotel-it
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_MONTHLY=12
# Scratch PostgreSQL database used to test-restore backups; its contents are replaced each time.
# BACKUP_VERIFY_DB=hotel_it_verify
# Folder of pg_dump.exe / pg_restore.exe if they are not on PATH.
# PG_BIN_DIR=C:\Program Files\PostgreSQL\16\bin

# --- Security -------------------------------------------------------------
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
SESSION_COOKIE_AGE_SECONDS=28800

# Address staff use to reach the system; used for links in notification emails.
SITE_BASE_URL=http://192.168.1.20:8000

# --- Email (optional; switch on in System Configuration) -------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=it-helpdesk@hotel.local

LOG_LEVEL=INFO
